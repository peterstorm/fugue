{
  "schemaVersion": 1,
  "kind": "loom-verification-manifest",
  "checks": [
    {
      "id": "project:xlsx-test",
      "scope": "wave",
      "executable": "bun",
      "args": [
        "test",
        "packages/xlsx/src",
        "--reporter=junit",
        "--reporter-outfile=.loom/completion-reports/xlsx-test.junit.xml"
      ],
      "cwd": ".",
      "timeoutMs": 600000,
      "report": {
        "kind": "required-file",
        "path": ".loom/completion-reports/xlsx-test.junit.xml"
      }
    },
    {
      "id": "project:xlsx-typecheck",
      "scope": "wave",
      "executable": "bun",
      "args": [
        "run",
        "--cwd",
        "packages/xlsx",
        "typecheck"
      ],
      "cwd": ".",
      "timeoutMs": 300000,
      "report": {
        "kind": "not-required"
      }
    },
    {
      "id": "project:document-source-test",
      "scope": "wave",
      "executable": "bun",
      "args": [
        "test",
        "packages/document-source/src"
      ],
      "cwd": ".",
      "timeoutMs": 300000,
      "report": {
        "kind": "not-required"
      }
    }
  ]
}
