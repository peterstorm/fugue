{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "scripts/check-doc-links.ts",
    "scripts/verify-prerequisites.ts",
    "scripts/__tests__/**/*.ts"
  ]
}
