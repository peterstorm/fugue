  "impureModules": [
    {
      "path": "packages/framework/src/types/clock.ts",
      "reason": "systemClock \u2014 the one sanctioned wall-clock read in the framework; every other module in types/ is pure, and nodes read time only through the clock capability"
    },
    {
      "path": "packages/host/src/domain/tenant-header.ts",
      "reason": "node:crypto's synchronous HMAC/timingSafeEqual primitives \u2014 pure computation over its inputs, but the purity rule's node: predicate cannot distinguish a primitive from I/O"
    },
    {
      "path": "packages/host/src/domain/capability-manager.ts",
      "reason": "lifecycle connect/close orchestration: it drives async handle connects and reports failed-cleanup diagnostics through an injected sink (the pure helpers it calls stay pure)"
    },
    {
      "path": "packages/host/src/domain/settle-before-deadline.ts",
      "reason": "races a promise against a timer: the timer is the one I/O this module exists to perform, and the caller needs the settlement to fire before an outer deadline rather than to compute anything"
    }
  ],
  "maxFunctionLines": 50,
  "excludeFromMaxLines": [
    ".test.ts",
    ".spec.ts",
    ".test.tsx",
    ".spec.tsx",
    ".property.test.ts"
  ],
  "maxDiscriminantBranches": 3,
  "discriminantTags": [
    "kind",
    "type",
    "status",
    "op",
    "phase",
    "format",
    "unit",
    "source"
  ],
  "duplicateBlockMinTokens": 100,
  "duplicateBlockMinLines": 8
}
