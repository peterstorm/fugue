{
  "exclude": [
    {
      "path": ".venv/",
      "reason": "python virtualenv for the eval/bench harness; site-packages hold third-party JavaScript (matplotlib, etc.) that no project rule governs"
    },
    {
      "path": "packages/framework/docs/examples/",
      "reason": "documentation samples shipped to readers verbatim \u2014 they import `@fuguejs/host/contract` on purpose to show the host wiring, and are compiled by the docs check rather than by a package tsconfig"
    },
    {
      "path": "packages/framework/src/__tests__/boundary-imports.test.ts",
      "reason": "its fixtures ARE import statements written as strings \u2014 the boundary checker's own corpus, unreadable by a text-based import extractor"
    },
    {
      "path": "packages/framework/src/__tests__/cli/fixtures/",
      "reason": "CLI fixture corpus: the near-identical invalid/success pairs ARE the test input, so identical blocks between fixture files are the point rather than duplicated logic"
    }
  ],
  "requireGovernance": [
    "packages/"
  ],
  "boundaries": [
