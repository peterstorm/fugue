{
  "name": "@fuguejs/framework",
  "version": "0.1.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterstorm/fugue.git",
    "directory": "packages/framework"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./advanced": "./src/advanced.ts",
    "./bullmq": "./src/bullmq.ts",
    "./redis": "./src/redis.ts",
    "./testing": "./src/testing.ts"
  },
  "bin": {
    "fugue": "./bin/fugue.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns='dist/**'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@azure/identity": "^4.13.0",
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.42",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.7.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.216.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "cron-parser": "^4.9.0",
    "openai": "^6.35.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "bullmq": "^5.76.6",
    "ioredis": "^5.10.1"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@types/bun": "^1.3.13",
    "fast-check": "^4.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "bin",
    "!src/**/__tests__"
  ]
}
