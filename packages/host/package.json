{
  "name": "@fuguejs/host",
  "version": "0.5.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterstorm/fugue.git",
    "directory": "packages/host"
  },
  "main": "src/index.ts",
  "bin": {
    "host": "src/main.ts",
    "fugue-thin-init": "src/main-thin-init.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test $(find src -path '*__tests__*' -name '*.test.ts' -not -name 'signals.test.ts' | sort) && bun test src/__tests__/lifecycle/signals.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@fuguejs/framework": "workspace:*",
    "@fuguejs/fs": "workspace:*",
    "@fuguejs/http-auth": "workspace:*",
    "@fuguejs/ms-graph": "workspace:*",
    "@fuguejs/oracle": "workspace:*",
    "hono": "^4.7.11",
    "ioredis": "^5.10.1",
    "jose": "6.1.0",
    "oracledb": "^7.0.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "bullmq": "^5.76.6",
    "fast-check": "^4.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "docs",
    "deploy",
    "!src/**/__tests__"
  ]
}
