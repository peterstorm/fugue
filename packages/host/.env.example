# Fugue Host — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# EVERY field below is OPTIONAL unless marked (required). A host with NONE of the
# Entra / Keycloak / Bot / HITL variables set boots and runs DAGs exactly as the
# pre-security baseline (SC-001).
#
# Every leg goes live this wave WHEN ITS OWN CONFIG IS PRESENT (config-presence
# gating, AD-3): set a leg's variables and its live transport is wired at boot;
# leave them unset and a fail-closed unwired stub stays wired instead (zero
# egress). This holds uniformly for the HITL / Bot legs AND the Entra / Keycloak
# agent-client legs below.

# ── Core (required) ──────────────────────────────────────────────────────────
# Git URL for the DAGs repository.
DAGS_REPO_URL=https://example.com/your-org/dags.git
# Branch to track (default: main).
DAGS_REPO_BRANCH=main
# Redis connection URL — required; the host refuses to start without it (FR-006).
REDIS_URL=redis://localhost:6379
# Admin bearer token: root of trust, full access, used to provision teams.
# Must be at least 16 characters.
ADMIN_TOKEN=change-me-to-a-long-random-secret
# HTTP port to listen on (default: 3000).
PORT=3000

# ── LLM provider (choose one: anthropic | openai | azure) ────────────────────
LLM_PROVIDER=anthropic
# Anthropic — required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI — required when LLM_PROVIDER=openai.
# OPENAI_API_KEY=sk-...
# Azure OpenAI — endpoint, key, and deployment required when LLM_PROVIDER=azure.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2025-03-01-preview

# ── Inbound realm JWT (fugue-platform OIDC) ──────────────────────────────────
# Issuer URL of the fugue-platform realm whose OIDC JWTs the host accepts as the
# `user` inbound mode (FR-W3-006). Unset → the JWT path stays disabled (only
# admin / fug_ team tokens are accepted, fail-closed). Setting it ALSO selects
# the live Keycloak capability broker at boot for per-node downstream-scope
# minting.
# REALM_JWT_ISSUER=https://keycloak.example.com/realms/fugue-platform
# Audience the host must appear in within an accepted realm JWT (default:
# fugue-host).
# REALM_JWT_AUDIENCE=fugue-host
# Keycloak realm policy: JSON mapping agentClientId → ["<provider>:<operation>", …]
# the fail-closed scope gate the broker consults BEFORE any Entra call
# (FR-W3-003). A client absent here has NO scopes (fail closed). Validated at
# boot — a malformed policy or an unrecognised scope name refuses startup.
# KEYS ARE REAL KEYCLOAK CLIENT IDS (FR-040): a DAG id is resolved to its
# agent-type client id via AGENT_CLIENT_MAP (below), and that real client id is
# what is keyed here — NOT the DAG id (the dagId→client placeholder is gone).
# AGENT_CLIENT_SCOPES={"fugue-agent-mail":["msgraph:mail.send"]}
# DAG-id → REAL Keycloak agent-type client-id map (FR-040, ADR-0056 Variant A:
# one service-account client per agent TYPE). The single migration point that
# resolves a run's DAG id to the client id on which AGENT_CLIENT_SCOPES and
# KEYCLOAK_AGENT_CLIENT_CREDENTIALS are keyed. A DAG id ABSENT here has no agent
# client → its origin resolution FAILS CLOSED (the run is refused, not minted as
# the wrong client). Validated at boot; unset/empty → every DAG fails closed.
# AGENT_CLIENT_MAP={"lead-desk":"fugue-agent-mail"}

# ── Entra (Azure AD) workload-identity-federation ────────────────────────────
# Microsoft Entra tenant id the WIF hop targets. ENTRA_TENANT_ID and
# ENTRA_CLIENT_ID are an INSEPARABLE PAIR — setting one without the other is
# rejected at boot (FR-001). Setting BOTH selects the live Entra WIF exchange +
# Graph transport at boot (config-presence gating, AD-3). Leave both unset and
# the fail-closed unwired stubs stay wired instead (zero Entra egress, SC-001).
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# The Entra application (client) id the host federates AS over WIF. Pair with
# ENTRA_TENANT_ID (see above).
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── Keycloak agent-client credentials (SENSITIVE) ────────────────────────────
# Override the Keycloak token endpoint the agent-client legs POST to
# (client-credentials mint + RFC 8693 exchange). Must be https — an agent client
# secret is sent here, so cleartext http is refused at boot (NFR-014). When unset
# the live endpoint derives its URL from the realm issuer.
# KEYCLOAK_TOKEN_URL=https://keycloak.example.com/realms/fugue-platform/protocol/openid-connect/token
# Per-agent-client Keycloak credentials: JSON mapping
#   agentClientId → { "clientId": "...", "clientSecret": "..." }
# SENSITIVE (NFR-014): these are client secrets — NEVER commit a real value and
# NEVER log them. Validated at boot (malformed JSON or a credential missing
# clientId/clientSecret refuses startup); a non-empty map selects the live
# Keycloak token endpoint at boot (config-presence gating, AD-3). Unset or empty
# leaves the fail-closed unwired endpoint wired instead.
# KEYCLOAK_AGENT_CLIENT_CREDENTIALS={"fugue-agent-mail":{"clientId":"kc-mail","clientSecret":"REDACTED"}}

# ── Dynamics 365 ─────────────────────────────────────────────────────────────
# The Dynamics 365 organization host the `dynamics:*` capabilities read from,
# used to build the per-org audience + handle (FR-042). Unset → DAGs requiring
# `dynamics` fail the boot-time capability check, exactly as today (SC-001).
# DYNAMICS_ORG_HOST=org.crm4.dynamics.com

# ── Documents capability adapter (ADR-0052) ──────────────────────────────────
# When unset, DAGs declaring requires: ["documents"] fail the boot-time check.
# `fs` wires @fuguejs/fs rooted at DOCUMENTS_FS_ROOT.
# DOCUMENTS_ADAPTER=fs
# DOCUMENTS_FS_ROOT=/var/lib/fugue/documents

# ── CDRator / Oister authenticated-REST capability (authedHttp, FR-060/NFR-010) ─
# The authenticated-REST leg into the CDRator/Oister core API: DAGs that declare
# requires: ["authedHttp"] (e.g. the betalinger-rabatter summary) call it to read
# customer/subscription data behind an operator-password bearer token.
# Wires the generic @fuguejs/http-auth capability under the key `authedHttp`
# (DAGs declare requires: ["authedHttp"]). Unset CDRATOR_URL → not registered, so
# such DAGs fail the boot-time capability check (zero regression). When CDRATOR_URL
# is set, the auth URL + brand key + the grant's credentials are ALL required.
# Credentials arrive ONLY from here and are never logged (NFR-010).
#
# CDRATOR_GRANT_TYPE selects the token-grant flavour:
#  - client_credentials (how the real Rator/toolbox+flexii integration authenticates):
#    two-legged grant. The client authenticates via HTTP Basic CLIENT_ID:CLIENT_SECRET
#    and the body carries brand_key + operator, NO username/password. Requires
#    CDRATOR_CLIENT_ID + CDRATOR_CLIENT_SECRET (and usually CDRATOR_OPERATOR).
#  - operator_password (default, legacy): resource-owner grant with form
#    username/password (CDRATOR_USERNAME/PASSWORD), optional HTTP Basic client header.
# CDRATOR_URL=https://rator1.ibt.oister.dk/rest-api-core/api          # must be https://
# CDRATOR_AUTH_URL=https://rator1.ibt.oister.dk/rest-api-auth/oauth/token  # must be https://
# CDRATOR_BRAND_KEY=oister
# CDRATOR_GRANT_TYPE=client_credentials  # or operator_password (default)
# --- client_credentials grant ---
# CDRATOR_CLIENT_ID=toolbox
# CDRATOR_CLIENT_SECRET=                 # SENSITIVE — never commit a real value
# CDRATOR_OPERATOR=peha                  # operator identity scoping the token
# --- operator_password grant (default) ---
# CDRATOR_USERNAME=operator
# CDRATOR_PASSWORD=                      # SENSITIVE — never commit a real value
#
# TLS: rator1 presents a chain rooted at the corporate self-signed CA "Hi3G OAM
# Root". Bun's fetch rejects it ("self signed certificate in certificate chain")
# unless the runtime trusts that root. Obtain the CA bundle from IT-Security (it is
# NOT committed to this public repo), mount it, and set NODE_EXTRA_CA_CERTS to its
# path — this trusts the corporate CA WITHOUT disabling verification.
# NODE_EXTRA_CA_CERTS=/etc/ssl/oister/oister-rator-ca-bundle.pem

# ── Oracle discount-pricing capability (`oracle`, FR-033/FR-040/FR-041) ──────
# Oracle Easy Connect / TNS connect string the `oracle` capability dials. Setting
# it (with the then-REQUIRED ORACLE_USER + ORACLE_PASSWORD) wires the
# @fuguejs/oracle capability under the key `oracle`, so DAGs declaring
# requires: ["oracle"] resolve. Unset → not registered, such DAGs fail the
# boot-time capability check (zero regression, mirrors documents/CDRator gating).
# The connect string + credentials arrive ONLY from here, are never hardcoded,
# and are never logged nor surfaced in errors (FR-040 / FR-041).
# Oracle easy-connect has no scheme — it is HOST:PORT/SERVICE, not a URL (unlike
# the CDRATOR_URL above, which is an https:// URL).
# ORACLE_CONNECT_STRING=dbhost:1521/PRICING
# ORACLE_USER=pricing_ro                 # required when ORACLE_CONNECT_STRING is set
# ORACLE_PASSWORD=                       # SENSITIVE — required when ORACLE_CONNECT_STRING is set; never commit a real value
# Connection-pool bounds. Optional — adapter defaults to min 0 / max 4. Must
# satisfy ORACLE_POOL_MIN <= ORACLE_POOL_MAX or boot is refused.
# ORACLE_POOL_MIN=0
# ORACLE_POOL_MAX=4

# ── Human-in-the-loop / HITL (ADR-0060) ──────────────────────────────────────
# HITL is ENABLED when EITHER the Teams webhook OR the Bot Framework pair is set.
# When NEITHER is configured, a DAG declaring a humanReview gate is refused (501).
#
# Transport 1 — Microsoft Teams Incoming Webhook (Workflows). Must be https://
# (the review card embeds output-under-review + an approval link; cleartext http
# is refused at boot).
# TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/webhookb2/...
# Public base URL of this host, used to build the approval deep-link in the Teams
# card (<base>/runs/<runId>). Falls back to http://localhost:<PORT>.
# HITL_APPROVAL_BASE_URL=https://fugue.example.com
#
# Transport 2 — Microsoft Bot Framework (in-Teams interactive Approve/Reject
# cards). BOT_APP_ID requires BOT_APP_PASSWORD (the pair is enforced at boot).
# Takes precedence over TEAMS_WEBHOOK_URL when both are set. Requires an Azure
# Bot resource + Teams app manifest (see docs/hitl-teams.md).
# BOT_APP_ID=00000000-0000-0000-0000-000000000000
# Bot Framework app password (client secret) — required when BOT_APP_ID is set.
# SENSITIVE: never log or commit a real value.
# BOT_APP_PASSWORD=REDACTED
# Override the Bot Framework token endpoint (single-tenant bots). Must be https —
# the app password is POSTed here.
# BOT_TOKEN_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
#
# Approver membership for the in-Teams button path (FR-041, SC-006): JSON map of a
# Teams user's aadObjectId → ["<fugue-team>", ...]. The authz GATE — a click is
# only recorded if the clicker is a member of the run's DAG-owning team. Unmapped
# aadObjectId → click authorizes nothing (fail closed).
# HITL_APPROVER_TEAMS={"11111111-1111-1111-1111-111111111111":["payments"]}
# Per-team channel routing (FR-041): JSON map of a Teams team aadGroupId →
# "<fugue-team>". A single bot account serves multiple teams; this routes a team's
# review cards to its OWN channel (confidentiality only — the authz gate above is
# what prevents acting on another team's runs). Unmapped → default channel.
# HITL_TEAM_CHANNELS={"22222222-2222-2222-2222-222222222222":"payments"}
#
# HITL tuning (sensible defaults shown):
# TTL (seconds) for persisted HITL runs + decisions. Default 7 days.
# HITL_RUN_TTL_SEC=604800
# Single-flight lock TTL (seconds) per run execution slice. Default 5 min.
# HITL_LOCK_TTL_SEC=300
# Max concurrent HITL run slices the worker processes. Default 4.
# HITL_WORKER_CONCURRENCY=4

# ── Observability (optional) ─────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_ID=0

# ── Multi-tenant supervisor (optional) ───────────────────────────────────────
# Per-tenant Redis ACL isolation (ADR-0067). OFF by default: isolation rests on
# the application-layer fugue:<tenant>: key prefixing and the worker uses the
# shared REDIS_URL credential. Set true to have the supervisor provision a
# per-tenant ~fugue:<tenant>:* ACL user at worker spawn and hand the credential to
# the worker, so a cross-tenant read is refused by Redis with NOPERM. REQUIRES an
# ACL-capable Redis whose REDIS_URL credential can run ACL SETUSER (deliberate
# operational step — see docs/migrations/tenant-key-namespacing.md).
# SUPERVISOR_REDIS_ACL_ENABLED=false
#
# Per-tenant worker crash-loop budget (auto-restart guard). Defaults shown.
# SUPERVISOR_MAX_WORKER_RESTARTS=5
# SUPERVISOR_WORKER_RESTART_WINDOW_MS=60000
#
# Liveness-poll interval (ms) for RE-ADOPTED workers (SC-006). A worker re-adopted
# across a supervisor restart has no exit-handle crash watcher, so this poll is its
# only crash signal — a dead re-adopted worker is detected and restarted instead of
# wedging the tenant at 503. Default 5000.
# WORKER_LIVENESS_SWEEP_MS=5000
#
# Supervisor admission + worker-lifecycle tunables (defaults shown; omit for the
# default). WORKER_HEAP_CAP_MB and SUPERVISOR_MAX_LIVE_WORKERS have NO default —
# unset means uncapped heap / unbounded live-worker count respectively.
# WORKER_UDS_DIR=/run/fugue                  # dir for per-tenant <tenant>.sock files
# SUPERVISOR_MAX_LIVE_WORKERS=               # max concurrently-live workers (admission cap); unset = unbounded
# WORKER_HEAP_CAP_MB=                        # per-worker V8 old-space cap (MB); unset = uncapped
# WORKER_IDLE_EVICT_MS=900000                # evict a non-pinned idle worker after this (15 min)
# SUPERVISOR_GRACE_WINDOW_MS=604800000       # retain a deregistered tenant's footprint before purge (7 days)
# SUPERVISOR_GRACE_PURGE_INTERVAL_MS=3600000 # how often the grace-purge sweep runs (1 hour)
#
# FUGUE_SUPERVISOR_HMAC_KEY signs the X-Fugue-Tenant header the supervisor stamps
# on each UDS-proxied request (the worker trusts the tenant ONLY via this HMAC).
# Set it in supervisor mode; the worker reads it to verify.
# FUGUE_SUPERVISOR_HMAC_KEY=
#
# FUGUE_REDIS_ACL_USERNAME / FUGUE_REDIS_ACL_PASSWORD are NOT set by operators —
# the supervisor mints and injects them into each worker's spawn env when ACL is
# enabled. Listed here only for documentation.
#
# ── thin-init (PID 1 of the multi-tenant pod) ────────────────────────────────
# Read by src/main-thin-init.ts (the default container CMD, AD-2). thin-init keeps
# the supervisor alive across crashes WITHOUT killing workers; these tune its
# crash-loop budget and shutdown grace. Defaults shown; invalid/out-of-range values
# fall back to the default (PID 1 never refuses to start over a typo).
# THIN_INIT_MAX_SUPERVISOR_RESTARTS=5          # max supervisor restarts per window before the pod gives up (exit 1 → k8s recreates); min 1
# THIN_INIT_SUPERVISOR_RESTART_WINDOW_MS=60000 # sliding window for the restart budget; min 1000
# THIN_INIT_SHUTDOWN_GRACE_MS=10000            # on SIGTERM, how long PID 1 waits for the supervisor + workers to drain before exiting; min 0.
#                                              # Keep this <= the k8s terminationGracePeriodSeconds (default 30s) so drain finishes before SIGKILL.
#                                              # WARNING: 0 = exit the pod immediately on SIGTERM → draining workers are hard-SIGKILLed (no graceful drain). Leave at the default unless you explicitly want that.
