.memory/
.claude/cortex-memory.local.md

node_modules/
dist/
.env
# Local secret env files (CDRator creds, etc.) — never commit. Keep .env.example tracked.
.env.*
!.env.example
*.tsbuildinfo
# Transient doc-example extraction scratch (swept up by tsconfig include otherwise)
**/__doc_check_dir__/
coverage/
.venv
.direnv
.pi/cortex-memory.local.md
bun.lockb
dump.rdb

# Python bytecode
__pycache__/
*.pyc

# Loom orchestration state (machine-local)
.claude/state/

# Ephemeral run evidence. These directories hold the events, checkpoints,
# contexts, transcripts, and receipts of individual Wave Gate, panel, and
# orchestration runs. They are audit data for a run in flight, not source:
# committing them would fold a run's own evidence into the change it audits.
.claude/reviews/review-and-fix-runs/
.claude/reviews/packets/
.claude/reviews/panel-runs/
.claude/specs/*/panel-runs/
.claude/**/orchestration-runs/
.claude/**/wave-gate-runs/

# fugue compose/new --from gauntlet staging dirs (always cleaned up, but never commit strays)
.fugue-compose/

# cortex memory plugin scratch
.cortex_extract.json

# Corporate CA material — never commit to this PUBLIC repo. Operators supply the
# Hi3G OAM CA bundle at deploy time via NODE_EXTRA_CA_CERTS (see host/.env.example).
*.pem
certs/
