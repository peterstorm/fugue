{
  "name": "fugue",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "infra:up": "bash scripts/infra-up.sh",
    "infra:down": "bash scripts/infra-down.sh",
    "eval": "podman-compose -f infra/compose.yaml --profile eval up --build eval",
    "eval:ci": "podman-compose -f infra/compose.yaml --profile eval-ci up --build eval-ci",
    "eval:pull-model": "bash scripts/pull-judge-model.sh",
    "dev": "bun run --filter customer-summary dev",
    "test:redis": "podman run --rm -d --name fugue-redis-test -p 6379:6379 redis:7-alpine && sleep 1 && REDIS_URL=redis://localhost:6379 bun run --filter '*' test; podman stop fugue-redis-test"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.215.0",
    "typescript": "^6.0.3",
    "yaml": "^2.8.3"
  }
}
