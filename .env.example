# AI Summary — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Server ---
PORT=3000

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_ID=0
# Tail-sampling fallback ratio (0.0–1.0). errorOnly + hadRetry policies always
# pass; this is the residual probability for traces matching neither.
# Production default 0.1 (10%); set to 1.0 in dev to capture everything.
TRACE_SAMPLE_RATIO=0.1

# --- LLM Provider (choose one: anthropic, openai, azure) ---
LLM_PROVIDER=azure

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-20250514

# OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://openai-infra-ph.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Eval (Flow Judge via Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
